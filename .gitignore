# USD is a build artifact regenerated from assets/r1/R1.urdf (see assets/r1/README.md).
# Keeping it out of git means the URDF stays the single source of truth.
assets/r1/usd/

# Python
__pycache__/
*.pyc

# Training runs: checkpoints, tensorboard events, per-run dumped configs --
# regenerated by scripts/train_r1.py, not meant to be tracked.
logs/

# Hydra's own per-invocation job log/config dump, auto-created by the
# @hydra_task_config decorator in train_r1.py/play_r1.py (one outputs/<date>/<time>/
# folder per run). Redundant with logs/rsl_rl/<run_id>/params/ -- not tracked.
outputs/

# Editor
.vscode/

# OS
.DS_Store
